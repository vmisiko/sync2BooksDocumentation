    "/connections/{connectionId}/syncs/{syncId}/transactions/{transactionId}/attachments": {
      "post": {
        "tags": ["Attachments"],
        "summary": "Upload an attachment",
        "description": "Attaches a receipt or supporting document to an already-synced transaction. Max 10MB; accepts jpg, jpeg, png, gif, pdf, doc, docx, xls, xlsx, txt, csv.",
        "parameters": [
          { "$ref": "#/components/parameters/ConnectionId" },
          { "name": "syncId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "transactionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "note": { "type": "string" },
                  "includeOnSend": { "type": "boolean", "description": "Whether to include this attachment when the document is sent/emailed from the accounting system." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Uploaded" },
          "400": { "description": "Invalid file, or the transaction isn't synced yet" },
          "404": { "description": "Connection, sync, or transaction not found" }
        }
      }
    },
